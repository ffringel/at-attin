# Bluesky (AT Protocol) account the bot posts as.
BSKY_HANDLE=
BSKY_PASSWORD=
# Bluesky PDS URL. Default: https://bsky.social
BSKY_API=https://bsky.social

# Source Mastodon account to mirror.
MASTODON_HANDLE=
MASTODON_ACCOUNT_ID=
# Mastodon API base URL. Default: https://mastodon.social/api/v1/
MASTODON_API=https://mastodon.social/api/v1/
# Optional access token — public timelines need no auth. Default: (empty)
MASTODON_ACCESS_TOKEN=

# Comma-separated keywords to skip on Bluesky. Default: #AD
GIVEAWAYS=#AD